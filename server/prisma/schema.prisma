// SQL Server không hỗ trợ enum trong Prisma → trạng thái lưu dạng VarChar, hằng số ở src/config/constants.js
// SQL Server cấm nhiều đường cascade → mặc định NoAction, xóa dữ liệu con xử lý trong service.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "sqlserver"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ───────────── Auth & RBAC ─────────────

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(30)
  name        String           @db.NVarChar(100)
  description String?          @db.NVarChar(255)
  accounts    Account[]
  permissions RolePermission[]
}

model Permission {
  id     Int              @id @default(autoincrement())
  code   String           @unique @db.VarChar(60)
  name   String           @db.NVarChar(150)
  module String           @db.VarChar(30)
  roles  RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
}

model Account {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(100)
  passwordHash String    @db.VarChar(255)
  roleId       Int
  status       String    @default("ACTIVE") @db.VarChar(20)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  role         Role      @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer     Customer?
  news         News[]

  @@index([roleId])
}

model Otp {
  id        Int       @id @default(autoincrement())
  email     String    @db.VarChar(100)
  codeHash  String    @db.VarChar(255)
  purpose   String    @default("RESET_PASSWORD") @db.VarChar(30)
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose])
}

// ───────────── Khách hàng ─────────────

model Customer {
  id        Int       @id @default(autoincrement())
  accountId Int       @unique
  fullName  String    @db.NVarChar(100)
  phone     String?   @db.VarChar(15)
  gender    String?   @db.VarChar(10)
  birthday  DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  account   Account   @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  addresses Address[]
  cart      Cart?
  orders    Order[]
  reviews   Review[]

  @@index([phone])
}

model Address {
  id           Int      @id @default(autoincrement())
  customerId   Int
  receiverName String   @db.NVarChar(100)
  phone        String   @db.VarChar(15)
  line         String   @db.NVarChar(255)
  ward         String   @db.NVarChar(100)
  district     String   @db.NVarChar(100)
  province     String   @db.NVarChar(100)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customerId])
}

// ───────────── Master data ─────────────

model Category {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.NVarChar(100)
  slug        String     @unique @db.VarChar(120)
  description String?    @db.NVarChar(255)
  imageUrl    String?    @db.VarChar(500)
  parentId    Int?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  vouchers    Voucher[]
  promotions  Promotion[]
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.NVarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?   @db.NVarChar(255)
  logoUrl     String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model League {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.NVarChar(100)
  slug      String   @unique @db.VarChar(120)
  country   String?  @db.NVarChar(50)
  type      String   @default("CLUB") @db.VarChar(20)
  logoUrl   String?  @db.VarChar(500)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teams     Team[]
}

model Team {
  id             Int         @id @default(autoincrement())
  name           String      @unique @db.NVarChar(100)
  slug           String      @unique @db.VarChar(120)
  shortName      String?     @db.VarChar(10)
  type           String      @default("CLUB") @db.VarChar(20)
  country        String?     @db.NVarChar(50)
  leagueId       Int?
  logoUrl        String?     @db.VarChar(500)
  primaryColor   String      @default("#0B1220") @db.VarChar(7)
  secondaryColor String      @default("#FFFFFF") @db.VarChar(7)
  kitPattern     String      @default("PLAIN") @db.VarChar(20)
  isFeatured     Boolean     @default(false)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  league         League?     @relation(fields: [leagueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products       Product[]
  promotions     Promotion[]

  @@index([leagueId])
}

model ProductType {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.NVarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?   @db.NVarChar(255)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Size {
  id        Int              @id @default(autoincrement())
  name      String           @db.VarChar(10)
  sizeType  String           @default("ADULT") @db.VarChar(10)
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  variants  ProductVariant[]

  @@unique([name, sizeType])
}

model Color {
  id        Int              @id @default(autoincrement())
  name      String           @unique @db.NVarChar(50)
  hex       String           @db.VarChar(7)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  variants  ProductVariant[]
  images    ProductImage[]
}

// ───────────── Sản phẩm & tồn kho ─────────────

model Product {
  id            Int              @id @default(autoincrement())
  name          String           @db.NVarChar(150)
  slug          String           @unique @db.VarChar(180)
  categoryId    Int
  brandId       Int?
  teamId        Int?
  productTypeId Int?
  season        String?          @db.VarChar(20)
  playerName    String?          @db.NVarChar(100)
  playerNumber  Int?
  gender        String?          @db.VarChar(10)
  material      String?          @db.NVarChar(100)
  description   String?          @db.NVarChar(Max)
  basePrice     Decimal          @db.Decimal(12, 0)
  salePrice     Decimal?         @db.Decimal(12, 0)
  status        String           @default("DRAFT") @db.VarChar(20)
  isFeatured    Boolean          @default(false)
  soldCount     Int              @default(0)
  ratingAvg     Float            @default(0)
  ratingCount   Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?
  category      Category         @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  brand         Brand?           @relation(fields: [brandId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  team          Team?            @relation(fields: [teamId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productType   ProductType?     @relation(fields: [productTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  images        ProductImage[]
  variants      ProductVariant[]
  orderDetails  OrderDetail[]
  reviews       Review[]
  vouchers      Voucher[]
  promotions    Promotion[]

  @@index([categoryId])
  @@index([brandId])
  @@index([teamId])
  @@index([status])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String   @db.VarChar(500)
  alt       String?  @db.NVarChar(150)
  colorId   Int?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  color     Color?   @relation(fields: [colorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([productId])
}

model ProductVariant {
  id            Int           @id @default(autoincrement())
  productId     Int
  sizeId        Int
  colorId       Int
  sku           String        @unique @db.VarChar(60)
  price         Decimal?      @db.Decimal(12, 0)
  stockQuantity Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  product       Product       @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  size          Size          @relation(fields: [sizeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  color         Color         @relation(fields: [colorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cartItems     CartItem[]
  orderDetails  OrderDetail[]
  inventoryLogs InventoryLog[]

  @@unique([productId, sizeId, colorId])
}

// Mỗi lần tồn kho thay đổi (nhập, điều chỉnh, đặt/hủy đơn) đều ghi lại để truy vết
model InventoryLog {
  id          Int            @id @default(autoincrement())
  variantId   Int
  change      Int
  stockAfter  Int
  reason      String         @db.VarChar(20)
  note        String?        @db.NVarChar(255)
  orderId     Int?
  createdById Int?
  createdAt   DateTime       @default(now())
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([variantId, createdAt])
}

// ───────────── Giỏ hàng & đơn hàng ─────────────

model Cart {
  id         Int        @id @default(autoincrement())
  customerId Int        @unique
  updatedAt  DateTime   @updatedAt
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items      CartItem[]
}

model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int
  variantId Int
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cartId, variantId])
}

model Order {
  id              Int                  @id @default(autoincrement())
  orderCode       String               @unique @db.VarChar(20)
  customerId      Int
  status          String               @default("PENDING") @db.VarChar(20)
  paymentStatus   String               @default("PENDING") @db.VarChar(20)
  paymentMethod   String               @db.VarChar(20)
  subtotal        Decimal              @db.Decimal(12, 0)
  discountAmount  Decimal              @default(0) @db.Decimal(12, 0)
  shippingFee     Decimal              @default(0) @db.Decimal(12, 0)
  total           Decimal              @db.Decimal(12, 0)
  voucherId       Int?
  voucherCode     String?              @db.VarChar(30)
  receiverName    String               @db.NVarChar(100)
  receiverPhone   String               @db.VarChar(15)
  shippingAddress String               @db.NVarChar(500)
  note            String?              @db.NVarChar(500)
  cancelReason    String?              @db.NVarChar(255)
  cancelledAt     DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  voucher         Voucher?             @relation(fields: [voucherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  details         OrderDetail[]
  payments        Payment[]
  history         OrderStatusHistory[]
  reviews         Review[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderDetail {
  id          Int            @id @default(autoincrement())
  orderId     Int
  variantId   Int
  productId   Int
  productName String         @db.NVarChar(150)
  sizeName    String         @db.VarChar(10)
  colorName   String         @db.NVarChar(50)
  imageUrl    String?        @db.VarChar(500)
  unitPrice   Decimal        @db.Decimal(12, 0)
  quantity    Int
  lineTotal   Decimal        @db.Decimal(12, 0)
  order       Order          @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product     Product        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId])
}

model OrderStatusHistory {
  id          Int      @id @default(autoincrement())
  orderId     Int
  fromStatus  String?  @db.VarChar(20)
  toStatus    String   @db.VarChar(20)
  note        String?  @db.NVarChar(255)
  changedById Int?
  changedAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId])
}

model Payment {
  id             Int       @id @default(autoincrement())
  orderId        Int
  method         String    @db.VarChar(20)
  amount         Decimal   @db.Decimal(12, 0)
  status         String    @default("PENDING") @db.VarChar(20)
  transactionRef String?   @db.VarChar(100)
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  order          Order     @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId])
}

// ───────────── Khuyến mãi ─────────────

model Promotion {
  id            Int       @id @default(autoincrement())
  name          String    @db.NVarChar(150)
  slug          String    @unique @db.VarChar(180)
  description   String?   @db.NVarChar(500)
  bannerUrl     String?   @db.VarChar(500)
  discountType  String    @db.VarChar(10)
  discountValue Decimal   @db.Decimal(12, 0)
  scope         String    @default("ALL") @db.VarChar(20)
  categoryId    Int?
  teamId        Int?
  productId     Int?
  startAt       DateTime
  endAt         DateTime
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  team          Team?     @relation(fields: [teamId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product       Product?  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Voucher {
  id            Int       @id @default(autoincrement())
  code          String    @unique @db.VarChar(30)
  description   String?   @db.NVarChar(255)
  discountType  String    @db.VarChar(10)
  discountValue Decimal   @db.Decimal(12, 0)
  maxDiscount   Decimal?  @db.Decimal(12, 0)
  minOrderValue Decimal   @default(0) @db.Decimal(12, 0)
  usageLimit    Int?
  usedCount     Int       @default(0)
  perUserLimit  Int?
  scope         String    @default("ALL") @db.VarChar(20)
  categoryId    Int?
  productId     Int?
  startAt       DateTime
  endAt         DateTime
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product       Product?  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders        Order[]
}

// ───────────── Đánh giá ─────────────

model Review {
  id         Int      @id @default(autoincrement())
  customerId Int
  productId  Int
  orderId    Int
  rating     Int
  content    String?  @db.NVarChar(1000)
  images     String?  @db.NVarChar(Max)
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product    Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([customerId, productId, orderId])
  @@index([productId])
}

// ───────────── Tin tức ─────────────

model NewsCategory {
  id        Int              @id @default(autoincrement())
  name      String           @unique @db.NVarChar(100)
  slug      String           @unique @db.VarChar(120)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  news      NewsOnCategory[]
}

model News {
  id           Int              @id @default(autoincrement())
  title        String           @db.NVarChar(200)
  slug         String           @unique @db.VarChar(220)
  summary      String?          @db.NVarChar(500)
  content      String           @db.NVarChar(Max)
  thumbnailUrl String?          @db.VarChar(500)
  status       String           @default("DRAFT") @db.VarChar(20)
  publishedAt  DateTime?
  authorId     Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  author       Account?         @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories   NewsOnCategory[]

  @@index([status, publishedAt])
}

model NewsOnCategory {
  newsId     Int
  categoryId Int
  news       News         @relation(fields: [newsId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category   NewsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([newsId, categoryId])
}

// ───────────── Cấu hình ─────────────

model SystemSetting {
  id                Int      @id @default(autoincrement())
  storeName         String   @default("JERSEY") @db.NVarChar(100)
  storeEmail        String?  @db.VarChar(100)
  storePhone        String?  @db.VarChar(15)
  storeAddress      String?  @db.NVarChar(255)
  currency          String   @default("VND") @db.VarChar(10)
  shippingFee       Decimal  @default(30000) @db.Decimal(12, 0)
  freeShipThreshold Decimal  @default(500000) @db.Decimal(12, 0)
  updatedAt         DateTime @updatedAt
}
